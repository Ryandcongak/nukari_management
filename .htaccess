Options -Indexes
RewriteEngine On

# Semua file upload hanya boleh dibaca melalui endpoint yang memeriksa sesi.
RewriteRule ^uploads/(.+)$ pages/files/download.php?path=uploads/$1 [L,QSA,NE]

# Batas ini selaras dengan upload multi-file aplikasi dan MAMP/mod_php.
<IfModule php_module>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_file_uploads 20
</IfModule>
